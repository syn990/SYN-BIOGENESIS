	<gene length="16.859969165160305" theta="4.031386253640881" color="gray" />
	<gene length="13.873074195138882" theta="4.377232292478871" color="red" />
	<gene length="6.070748233635252" theta="2.4041599107862015" color="white" />
</genetic_code>
