<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE genetic_code [
<!ELEMENT genetic_code (gene+)>
<!ATTLIST genetic_code symmetry (1|2|3|4|5|6|7|8) #REQUIRED>
<!ATTLIST genetic_code mirror (yes|no) #REQUIRED>
<!ATTLIST genetic_code disperse (yes|no) #REQUIRED>
<!ELEMENT gene EMPTY>
<!ATTLIST gene length CDATA #REQUIRED>
<!ATTLIST gene theta CDATA #REQUIRED>
<!ATTLIST gene color (red|green|blue|cyan|yellow|gray|white) #REQUIRED>
]>
<genetic_code symmetry="7" mirror="yes" disperse="yes">
	<gene length="17.402904521183796" theta="0.6819190226181205" color="cyan" />
	<gene length="14.512594071164644" theta="0.917141504668725" color="green" />
	<gene length="13.556317762925742" theta="0.6999372334485908" color="white" />
	<gene length="17.673023872047914" theta="2.379163066872182" color="green" />
</genetic_code>
