<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE genetic_code [
<!ELEMENT genetic_code (gene+)>
<!ATTLIST genetic_code symmetry (1|2|3|4|5|6|7|8) #REQUIRED>
<!ATTLIST genetic_code mirror (yes|no) #REQUIRED>
<!ATTLIST genetic_code disperse (yes|no) #REQUIRED>
<!ELEMENT gene EMPTY>
<!ATTLIST gene length CDATA #REQUIRED>
<!ATTLIST gene theta CDATA #REQUIRED>
<!ATTLIST gene color (red|green|blue|cyan|yellow|gray|white) #REQUIRED>
]>
<genetic_code symmetry="1" mirror="yes" disperse="no">
	<gene length="14.85675102745161" theta="5.82424704986262" color="cyan" />
	<gene length="16.744155549983688" theta="1.6343225820279683" color="blue" />
	<gene length="9.466497720630976" theta="4.817339183387696" color="blue" />
	<gene length="14.927348427084622" theta="3.5049995587097786" color="green" />
</genetic_code>
