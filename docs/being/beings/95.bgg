<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE genetic_code [
<!ELEMENT genetic_code (gene+)>
<!ATTLIST genetic_code symmetry (1|2|3|4|5|6|7|8) #REQUIRED>
<!ATTLIST genetic_code mirror (yes|no) #REQUIRED>
<!ATTLIST genetic_code disperse (yes|no) #REQUIRED>
<!ELEMENT gene EMPTY>
<!ATTLIST gene length CDATA #REQUIRED>
<!ATTLIST gene theta CDATA #REQUIRED>
<!ATTLIST gene color (red|green|blue|cyan|yellow|gray|white) #REQUIRED>
]>
<genetic_code symmetry="8" mirror="no" disperse="yes">
	<gene length="13.610959890962288" theta="1.5995122517264575" color="green" />
	<gene length="17.77658249365335" theta="2.785056035798057" color="green" />
	<gene length="16.78370129798497" theta="3.3741263003885855" color="green" />
	<gene length="16.725295156617722" theta="3.255380386554366" color="green" />
</genetic_code>
