<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE genetic_code [
<!ELEMENT genetic_code (gene+)>
<!ATTLIST genetic_code symmetry (1|2|3|4|5|6|7|8) #REQUIRED>
<!ATTLIST genetic_code mirror (yes|no) #REQUIRED>
<!ATTLIST genetic_code disperse (yes|no) #REQUIRED>
<!ELEMENT gene EMPTY>
<!ATTLIST gene length CDATA #REQUIRED>
<!ATTLIST gene theta CDATA #REQUIRED>
<!ATTLIST gene color (red|green|blue|cyan|yellow|gray|white) #REQUIRED>
]>
<genetic_code symmetry="8" mirror="yes" disperse="no">
	<gene length="7.662966575003438" theta="4.266421920643393" color="gray" />
	<gene length="17.723868867657636" theta="3.8991641014921288" color="green" />
	<gene length="17.82585152676465" theta="2.4563934359518806" color="green" />
	<gene length="17.938306280007026" theta="1.0794952658526704" color="green" />
</genetic_code>
