<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE genetic_code [
<!ELEMENT genetic_code (gene+)>
<!ATTLIST genetic_code symmetry (1|2|3|4|5|6|7|8) #REQUIRED>
<!ATTLIST genetic_code mirror (yes|no) #REQUIRED>
<!ATTLIST genetic_code disperse (yes|no) #REQUIRED>
<!ELEMENT gene EMPTY>
<!ATTLIST gene length CDATA #REQUIRED>
<!ATTLIST gene theta CDATA #REQUIRED>
<!ATTLIST gene color (red|green|blue|cyan|yellow|gray|white) #REQUIRED>
]>
<genetic_code symmetry="1" mirror="no" disperse="yes">
	<gene length="16.663517437459774" theta="5.435091868476387" color="green" />
	<gene length="17.68306969936806" theta="2.4388189150569057" color="green" />
	<gene length="12.402199569544997" theta="3.0351597498392198" color="red" />
	<gene length="6.4418223233218015" theta="4.493398961594178" color="gray" />
</genetic_code>
