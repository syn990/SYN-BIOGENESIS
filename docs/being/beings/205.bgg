	<gene length="4.858925443915137" theta="4.6878430966711155" color="cyan" />
	<gene length="8.626969829927154" theta="1.5737525174455587" color="green" />
	<gene length="2.7692287105677433" theta="5.116894517991653" color="white" />
	<gene length="9.244199540937954" theta="4.444111566484623" color="white" />
</genetic_code>
