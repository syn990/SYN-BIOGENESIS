<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE genetic_code [
<!ELEMENT genetic_code (gene+)>
<!ATTLIST genetic_code symmetry (1|2|3|4|5|6|7|8) #REQUIRED>
<!ATTLIST genetic_code mirror (yes|no) #REQUIRED>
<!ATTLIST genetic_code disperse (yes|no) #REQUIRED>
<!ELEMENT gene EMPTY>
<!ATTLIST gene length CDATA #REQUIRED>
<!ATTLIST gene theta CDATA #REQUIRED>
<!ATTLIST gene color (red|green|blue|cyan|yellow|gray|white) #REQUIRED>
]>
<genetic_code symmetry="8" mirror="yes" disperse="yes">
	<gene length="17.967853672871477" theta="2.6543480876426506" color="green" />
	<gene length="17.046034747069783" theta="6.103992733536507" color="green" />
	<gene length="6.024963911252891" theta="3.17760565883429" color="white" />
	<gene length="15.706623729250792" theta="5.352587473992748" color="green" />
</genetic_code>
