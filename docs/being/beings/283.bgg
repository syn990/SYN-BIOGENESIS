<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE genetic_code [
<!ELEMENT genetic_code (gene+)>
<!ATTLIST genetic_code symmetry (1|2|3|4|5|6|7|8) #REQUIRED>
<!ATTLIST genetic_code mirror (yes|no) #REQUIRED>
<!ATTLIST genetic_code disperse (yes|no) #REQUIRED>
<!ELEMENT gene EMPTY>
<!ATTLIST gene length CDATA #REQUIRED>
<!ATTLIST gene theta CDATA #REQUIRED>
<!ATTLIST gene color (red|green|blue|cyan|yellow|gray|white) #REQUIRED>
]>
<genetic_code symmetry="5" mirror="yes" disperse="no">
	<gene length="15.479036417958065" theta="3.0105646726262156" color="green" />
	<gene length="12.37677183943583" theta="5.675373110019375" color="cyan" />
	<gene length="3.5466007226212746" theta="4.697003475937088" color="blue" />
	<gene length="4.3417388736480245" theta="5.758418054705467" color="green" />
</genetic_code>
