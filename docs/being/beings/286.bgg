	<gene length="4.376580777171959" theta="5.069951072883021" color="blue" />
	<gene length="2.226109976628363" theta="0.6668592170290341" color="green" />
	<gene length="2.8220059673547517" theta="2.1803774210500664" color="cyan" />
	<gene length="16.952699037734714" theta="5.938057326569732" color="green" />
</genetic_code>
