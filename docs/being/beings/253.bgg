<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE genetic_code [
<!ELEMENT genetic_code (gene+)>
<!ATTLIST genetic_code symmetry (1|2|3|4|5|6|7|8) #REQUIRED>
<!ATTLIST genetic_code mirror (yes|no) #REQUIRED>
<!ATTLIST genetic_code disperse (yes|no) #REQUIRED>
<!ELEMENT gene EMPTY>
<!ATTLIST gene length CDATA #REQUIRED>
<!ATTLIST gene theta CDATA #REQUIRED>
<!ATTLIST gene color (red|green|blue|cyan|yellow|gray|white) #REQUIRED>
]>
<genetic_code symmetry="4" mirror="yes" disperse="no">
	<gene length="16.849922902974583" theta="4.513720274103122" color="green" />
	<gene length="15.414868665657822" theta="2.2350197300673655" color="green" />
	<gene length="5.2007770855819135" theta="1.4428505581558029" color="cyan" />
	<gene length="16.02313643012182" theta="5.995283496350211" color="green" />
</genetic_code>
