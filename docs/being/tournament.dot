  n525 -> n555 [style=solid, color="#555555", penwidth=0.8];
  champion [shape=doubleoctagon, style=filled, fillcolor="#e00000", color="#e00000", fontcolor="#ffffff", fontsize=16, label="the champion\n#496"];
  n496 -> champion [color="#e00000", penwidth=3];
}
