# SYN-BIOGENESIS: Biogenesis 0.9 rewritten in C.
# Copyright (C) 2026 syn990
# SPDX-License-Identifier: GPL-2.0-or-later (see LICENSE)

CC = gcc
# -fwrapv: the java.awt geometry checks in src/sim/jgeom.c rely on Java's
# wrapping int overflow. -ffp-contract=off: no fused multiply-adds, so the
# floating point matches the Java original operation for operation (the
# javaref comparison depends on it).
CFLAGS = -Wall -Wextra -std=c11 -O2 -g -Isrc -fwrapv -ffp-contract=off -D_DEFAULT_SOURCE
LDLIBS = -lm

PKG_CONFIG ?= pkg-config
SDL_CFLAGS = $(shell $(PKG_CONFIG) --cflags sdl2 SDL2_ttf SDL2_image)
SDL_LIBS = $(shell $(PKG_CONFIG) --libs sdl2 SDL2_ttf SDL2_image)

SIM_SRC = src/sim/jrandom.c src/sim/jgeom.c src/sim/params.c src/sim/genetic_code.c \
          src/sim/organism.c src/sim/world.c src/sim/stats.c \
          src/io/bgg.c src/io/worldfile.c src/io/jser.c src/io/bgw.c
CORE_SRC = $(SIM_SRC) src/headless.c src/main.c
UI_SRC = $(wildcard src/ui/*.c)

# The JVM's Math, bit for bit (see src/sim/jmath.h): fdlibm's atan2 and
# HotSpot's sin/cos/pow routines (generated by tools/jvmlibm/).
MATH_OBJ = obj/fdlibm/e_atan2.o obj/fdlibm/s_atan.o obj/fdlibm/s_fabs.o obj/sim/jvm_libm_x86_64.o
FDLIBM_RENAME = -D__LITTLE_ENDIAN -D__ieee754_atan2=fd_atan2 -Datan=fd_atan -Dfabs=fd_fabs

OBJ = $(patsubst src/%.c,obj/%.o,$(CORE_SRC) $(UI_SRC)) $(MATH_OBJ)
HEADLESS_OBJ = $(patsubst src/%.c,obj/headless/%.o,$(CORE_SRC)) $(MATH_OBJ)

LIBC_OBJ = $(patsubst src/%.c,obj/libc/%.o,$(CORE_SRC)) $(MATH_OBJ)

.PHONY: all headless libc test clean

all: syn-biogenesis

syn-biogenesis: $(OBJ)
	$(CC) -o $@ $^ $(SDL_LIBS) $(LDLIBS)

# No SDL needed: the simulation alone, for benchmarks and the javaref check.
headless: syn-biogenesis-headless

syn-biogenesis-headless: $(HEADLESS_OBJ)
	$(CC) -o $@ $^ $(LDLIBS)

# The headless simulation on the C library's sin/cos/pow instead of the
# JVM's (what builds for other processors use), for tools/drift.
libc: syn-biogenesis-headless-libc

syn-biogenesis-headless-libc: $(LIBC_OBJ)
	$(CC) -o $@ $^ $(LDLIBS)

obj/libc/%.o: src/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -DBIO_NO_GUI -DBIO_LIBC_MATH -MMD -c -o $@ $<

# K&R-era code: type punning through int pointers, so no strict aliasing.
obj/fdlibm/%.o: src/fdlibm/%.c
	@mkdir -p $(dir $@)
	$(CC) -std=gnu89 -O1 -fno-strict-aliasing -fwrapv -ffp-contract=off -w $(FDLIBM_RENAME) -c -o $@ $<

obj/sim/jvm_libm_x86_64.o: src/sim/jvm_libm_x86_64.S
	@mkdir -p $(dir $@)
	$(CC) -c -o $@ $<

obj/ui/%.o: src/ui/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(SDL_CFLAGS) -MMD -c -o $@ $<

obj/main.o: src/main.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(SDL_CFLAGS) -MMD -c -o $@ $<

obj/%.o: src/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -c -o $@ $<

obj/headless/%.o: src/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -DBIO_NO_GUI -MMD -c -o $@ $<

tests/geom_check: tests/geom_check.c src/sim/jgeom.c src/sim/jrandom.c
	$(CC) $(CFLAGS) -o $@ $^ $(LDLIBS)

tests/bgg_tool: tests/bgg_tool.c $(SIM_SRC) $(MATH_OBJ)
	$(CC) $(CFLAGS) -o $@ $^ $(LDLIBS)

tests/sim_check: tests/sim_check.c $(SIM_SRC) $(MATH_OBJ)
	$(CC) $(CFLAGS) -o $@ $^ $(LDLIBS)

tests/math_check: tests/math_check.c $(MATH_OBJ)
	$(CC) $(CFLAGS) -o $@ $^ $(LDLIBS)

tests/num_check: tests/num_check.c $(SIM_SRC) $(MATH_OBJ)
	$(CC) $(CFLAGS) -o $@ $^ $(LDLIBS)

tests/bgw_fuzz: tests/bgw_fuzz.c $(SIM_SRC) $(MATH_OBJ)
	$(CC) $(CFLAGS) -o $@ $^ $(LDLIBS)

# File format checks, the java.awt geometry against the JVM, and the
# frame-by-frame comparison with the Java original (the last two need a
# JDK; see tools/javaref/README.md).
test: syn-biogenesis-headless tests/geom_check tests/sim_check tests/bgg_tool tests/math_check tests/num_check tests/bgw_fuzz
	tests/run.sh

clean:
	rm -rf obj syn-biogenesis syn-biogenesis-headless syn-biogenesis-headless-libc tests/geom_check \
		tests/sim_check tests/bgg_tool tests/math_check tests/num_check tests/bgw_fuzz

-include $(OBJ:.o=.d) $(HEADLESS_OBJ:.o=.d) $(LIBC_OBJ:.o=.d)
